#------------------------------------------------------------------------------
# File:         gpx.fmt
#
# Description:  ExifTool print-format template to generate a GPX track log from
#               a video's embedded GPS stream. Bundled so we can pass an explicit
#               path (exiftool -ee -p gpx.fmt) rather than relying on the copy in
#               the ExifTool distribution being on the working path.
#
# Usage:        exiftool -ee -p gpx.fmt FILE > out.gpx
#------------------------------------------------------------------------------
#[HEAD]<?xml version="1.0" encoding="utf-8"?>
#[HEAD]<gpx version="1.0"
#[HEAD] creator="ExifTool $ExifToolVersion"
#[HEAD] xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
#[HEAD] xmlns="http://www.topografix.com/GPX/1/0"
#[HEAD] xsi:schemaLocation="http://www.topografix.com/GPX/1/0 http://www.topografix.com/GPX/1/0/gpx.xsd">
#[HEAD]<trk>
#[HEAD]<number>1</number>
#[HEAD]<trkseg>
#[IF]  $gpslatitude $gpslongitude
#[BODY]<trkpt lat="$gpslatitude#" lon="$gpslongitude#">
#[BODY]  <time>${gpsdatetime#;my ($ss)=/(\.\d+)/;s/[-+].*//;s/(\d{4}):(\d{2}):(\d{2}) /$1-$2-${3}T/;$_ .= ($ss || '') . 'Z'}</time>
#[BODY]  <ele>$gpsaltitude#</ele>
#[BODY]</trkpt>
#[TAIL]</trkseg>
#[TAIL]</trk>
#[TAIL]</gpx>
